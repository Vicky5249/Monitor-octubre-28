<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Monitor del Vochito</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    min-height: 100vh;
    background:
        radial-gradient(
            circle at top left,
            #18283d,
            transparent 35%
        ),
        radial-gradient(
            circle at bottom right,
            #1d1025,
            transparent 35%
        ),
        #070b11;
    color: white;
    padding: 25px;
}

.container {
    max-width: 1050px;
    margin: auto;
}

.header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 30px;
}

.logo {
    display: flex;
    align-items: center;
    gap: 14px;
}

.logo h1 {
    font-size: 22px;
    letter-spacing: 1px;
}

.logo p {
    color: #7f8a9a;
    font-size: 13px;
    margin-top: 4px;
}

.connection {
    display: flex;
    align-items: center;
    gap: 8px;
    background: rgba(255,255,255,.06);
    border: 1px solid rgba(255,255,255,.08);
    padding: 9px 14px;
    border-radius: 30px;
    color: #aab4c3;
    font-size: 13px;
}

.dot {
    width: 9px;
    height: 9px;
    background: #31e981;
    border-radius: 50%;
    box-shadow: 0 0 12px #31e981;
}

.title {
    margin-bottom: 18px;
}

.title h2 {
    font-size: 30px;
    margin-bottom: 5px;
}

.title p {
    color: #7f8a9a;
}

.cards {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 22px;
}

.card {
    position: relative;
    overflow: hidden;
    background:
        linear-gradient(
            145deg,
            rgba(255,255,255,.075),
            rgba(255,255,255,.025)
        );
    border: 1px solid rgba(255,255,255,.09);
    border-radius: 28px;
    padding: 28px;
    backdrop-filter: blur(18px);
    box-shadow: 0 20px 60px rgba(0,0,0,.35);
}

.card::before {
    content: "";
    position: absolute;
    width: 180px;
    height: 180px;
    border-radius: 50%;
    background: rgba(30,144,255,.08);
    top: -90px;
    right: -70px;
}

.card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
}

.sensor-name {
    display: flex;
    align-items: center;
    gap: 12px;
}

.sensor-icon {
    width: 45px;
    height: 45px;
    border-radius: 14px;
    background: rgba(30,144,255,.12);
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 22px;
}

.sensor-name h3 {
    font-size: 16px;
}

.sensor-name span {
    display: block;
    color: #6f7b8b;
    font-size: 12px;
    margin-top: 3px;
}

.sensor-number {
    color: #5f6b7c;
    font-size: 12px;
}

.temp-area {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
}

.temperature {
    font-size: 65px;
    font-weight: 700;
    letter-spacing: -3px;
}

.temperature span {
    font-size: 25px;
    color: #8792a2;
    letter-spacing: 0;
}

.gauge {
    width: 125px;
    height: 125px;
    border-radius: 50%;
    display: flex;
    justify-content: center;
    align-items: center;
    background:
        conic-gradient(
            #1e90ff 0deg,
            #1e90ff 120deg,
            rgba(255,255,255,.07) 120deg,
            rgba(255,255,255,.07) 360deg
        );
    position: relative;
}

.gauge::before {
    content: "";
    position: absolute;
    width: 92px;
    height: 92px;
    background: #111720;
    border-radius: 50%;
}

.gauge-content {
    position: relative;
    text-align: center;
}

.gauge-content strong {
    display: block;
    font-size: 17px;
}

.gauge-content span {
    color: #687486;
    font-size: 10px;
}

.status {
    margin-top: 25px;
    padding: 13px 15px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    gap: 10px;
    background: rgba(49,233,129,.08);
    border: 1px solid rgba(49,233,129,.12);
    color: #31e981;
    font-size: 13px;
    font-weight: bold;
}

.status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: currentColor;
}

.info {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-top: 14px;
}

.info-box {
    background: rgba(255,255,255,.035);
    border-radius: 12px;
    padding: 12px;
}

.info-box span {
    display: block;
    color: #697587;
    font-size: 11px;
    margin-bottom: 5px;
}

.info-box strong {
    font-size: 14px;
}

.system {
    margin-top: 22px;
    background:
        linear-gradient(
            145deg,
            rgba(255,255,255,.06),
            rgba(255,255,255,.025)
        );
    border: 1px solid rgba(255,255,255,.08);
    border-radius: 22px;
    padding: 20px 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.system-title {
    color: #8994a4;
    font-size: 12px;
}

.system-value {
    margin-top: 4px;
    font-size: 15px;
    font-weight: bold;
}

.update {
    color: #697587;
    font-size: 12px;
}

.footer {
    text-align: center;
    margin-top: 25px;
    color: #505b6a;
    font-size: 11px;
}

@media(max-width: 750px) {
    body {
        padding: 15px;
    }
    .header {
        align-items: flex-start;
    }
    .connection {
        font-size: 0;
        padding: 12px;
    }
    .connection .dot {
        margin: 0;
    }
    .cards {
        grid-template-columns: 1fr;
    }
    .title h2 {
        font-size: 25px;
    }
}

@media(max-width: 430px) {
    .temp-area {
        flex-direction: column;
        align-items: flex-start;
    }
    .gauge {
        align-self: center;
    }
    .temperature {
        font-size: 58px;
    }
    .system {
        flex-direction: column;
        align-items: flex-start;
        gap: 12px;
    }
}
</style>
</head>

<body>
<div class="container">
    <div class="header">
        <div class="logo">
            <div>
                <h1>Vochito</h1>
                <p>Monitor del Sistema de Audio de un Automovil</p>
            </div>
        </div>
        <div class="connection">
            <div class="dot"></div>
            ESP32 CONECTADO
        </div>
    </div>

    <div class="cards">
        <!-- Sensor 1 -->
        <div class="card">
            <div class="card-top">
                <div class="sensor-name">
                    <div>
                        <h3>Amplificador</h3>
                        <span>DS18B20 • GPIO 27</span>
                    </div>
                </div>
                <div class="sensor-number">SENSOR 01</div>
            </div>
            <div class="temp-area">
                <div class="temperature"><span id="temp1">--</span><span>°C</span></div>
                <div class="gauge" id="gauge1">
                    <div class="gauge-content">
                        <strong id="gaugeText1">--°</strong>
                        <span>TEMP.</span>
                    </div>
                </div>
            </div>
            <div id="status1" class="status">
                <div class="status-dot"></div>
                <span>Conectando...</span>
            </div>
            <div class="info">
                <div class="info-box"><span>LÍMITE DE AVISO</span><strong>50 °C</strong></div>
                <div class="info-box"><span>LÍMITE CRÍTICO</span><strong>70 °C</strong></div>
            </div>
        </div>

        <!-- Sensor 2 -->
        <div class="card">
            <div class="card-top">
                <div class="sensor-name">
                    <div>
                        <h3>Sensor Auxiliar</h3>
                        <span>DS18B20 • GPIO 26</span>
                    </div>
                </div>
                <div class="sensor-number">SENSOR 02</div>
            </div>
            <div class="temp-area">
                <div class="temperature"><span id="temp2">--</span><span>°C</span></div>
                <div class="gauge" id="gauge2">
                    <div class="gauge-content">
                        <strong id="gaugeText2">--°</strong>
                        <span>TEMP.</span>
                    </div>
                </div>
            </div>
            <div id="status2" class="status">
                <div class="status-dot"></div>
                <span>Conectando...</span>
            </div>
            <div class="info">
                <div class="info-box"><span>LÍMITE DE AVISO</span><strong>50 °C</strong></div>
                <div class="info-box"><span>LÍMITE CRÍTICO</span><strong>70 °C</strong></div>
            </div>
        </div>

        <!-- Sensor 3 -->
        <div class="card">
            <div class="card-top">
                <div class="sensor-name">
                    <div class="sensor-icon">🔊</div>
                    <div>
                        <h3>Sensor de sonido</h3>
                        <span>Sensor analógico de sonido • GPIO 34</span>
                    </div>
                </div>
                <div class="sensor-number">SENSOR 03</div>
            </div>
            <div class="temp-area">
                <div class="temperature"><span id="sonido">--</span><span>%</span></div>
                <div class="gauge" id="gaugeSonido">
                    <div class="gauge-content"><strong id="gaugeTextSonido">--%</strong><span>NIVEL</span></div>
                </div>
            </div>
            <div id="statusSonido" class="status"><div class="status-dot"></div><span>Conectando...</span></div>
            <div class="info">
                <div class="info-box"><span>DETECCIÓN</span><strong id="deteccionSonido">Sin datos</strong></div>
                <div class="info-box"><span>TIPO</span><strong>Intensidad relativa</strong></div>
            </div>
        </div>

        <!-- Sensor 4 -->
        <div class="card">
            <div class="card-top">
                <div class="sensor-name">
                    <div class="sensor-icon">⚡</div>
                    <div>
                        <h3>Voltaje del amplificador</h3>
                        <span>Medidor de voltaje • ADC GPIO 35</span>
                    </div>
                </div>
                <div class="sensor-number">SENSOR 04</div>
            </div>
            <div class="temp-area">
                <div class="temperature"><span id="voltaje">--</span><span>V</span></div>
                <div class="gauge" id="gaugeVoltaje">
                    <div class="gauge-content"><strong id="gaugeTextVoltaje">-- V</strong><span>VOLTAJE</span></div>
                </div>
            </div>
            <div id="statusVoltaje" class="status"><div class="status-dot"></div><span>Conectando...</span></div>
            <div class="info">
                <div class="info-box"><span>VOLTAJE MÍNIMO</span><strong>11.5 V*</strong></div>
                <div class="info-box"><span>VOLTAJE MÁXIMO</span><strong>14.8 V*</strong></div>
            </div>
        </div>
    </div>

    <div class="system">
        <div>
            <div class="system-title">SISTEMA DE MONITOREO</div>
            <div class="system-value">ESP32 • 4 sensores monitorizados</div>
        </div>
        <div class="update">Actualización automática: 2 s</div>
    </div>

    <div class="footer">
        Ingenieria en Sistemas Automotrices
    </div>
</div>

<script>
function pintarEstado(id, color, fondo, mensaje) {
    const estado = document.getElementById(id);
    estado.style.color = color;
    estado.style.background = fondo;
    estado.querySelector("span").innerText = mensaje;
}

function actualizarSonido(valor) {
    if (typeof valor !== "number" || !Number.isFinite(valor)) {
        document.getElementById("sonido").innerText = "--";
        document.getElementById("gaugeTextSonido").innerText = "--%";
        document.getElementById("deteccionSonido").innerText = "Sin datos";
        pintarEstado("statusSonido", "#ff69b4", "rgba(255,105,180,.08)", "ERROR DE SENSOR");
        return;
    }

    const nivel = Math.max(0, Math.min(100, valor));
    document.getElementById("sonido").innerText = nivel.toFixed(0);
    document.getElementById("gaugeTextSonido").innerText = nivel.toFixed(0) + "%";
    document.getElementById("deteccionSonido").innerText = nivel >= 20 ? "Sonido detectado" : "Ambiente silencioso";

    const color = nivel >= 70 ? "#ff5c5c" : nivel >= 20 ? "#f5c542" : "#31e981";
    const grados = nivel * 3.6;
    document.getElementById("gaugeSonido").style.background =
        `conic-gradient(${color} 0deg, ${color} ${grados}deg, rgba(255,255,255,.07) ${grados}deg, rgba(255,255,255,.07) 360deg)`;
    pintarEstado("statusSonido", color, nivel >= 70 ? "rgba(255,92,92,.08)" : nivel >= 20 ? "rgba(245,197,66,.08)" : "rgba(49,233,129,.08)",
        nivel >= 70 ? "SONIDO INTENSO" : nivel >= 20 ? "SONIDO DETECTADO" : "NIVEL BAJO");
}

function actualizarVoltaje(valor) {
    if (typeof valor !== "number" || !Number.isFinite(valor)) {
        document.getElementById("voltaje").innerText = "--";
        document.getElementById("gaugeTextVoltaje").innerText = "-- V";
        pintarEstado("statusVoltaje", "#ff69b4", "rgba(255,105,180,.08)", "ERROR DE SENSOR");
        return;
    }

    document.getElementById("voltaje").innerText = valor.toFixed(2);
    document.getElementById("gaugeTextVoltaje").innerText = valor.toFixed(2) + " V";
    const porcentaje = Math.max(0, Math.min(100, (valor / 16) * 100));
    const grados = porcentaje * 3.6;
    const color = valor < 11.5 || valor > 14.8 ? "#ff5c5c" : "#31e981";
    document.getElementById("gaugeVoltaje").style.background =
        `conic-gradient(${color} 0deg, ${color} ${grados}deg, rgba(255,255,255,.07) ${grados}deg, rgba(255,255,255,.07) 360deg)`;

    if (valor < 11.5) {
        pintarEstado("statusVoltaje", "#ff5c5c", "rgba(255,92,92,.08)", "VOLTAJE BAJO");
    } else if (valor > 14.8) {
        pintarEstado("statusVoltaje", "#ff5c5c", "rgba(255,92,92,.08)", "VOLTAJE ALTO");
    } else {
        pintarEstado("statusVoltaje", "#31e981", "rgba(49,233,129,.08)", "VOLTAJE EN RANGO");
    }
}

function actualizarTemperaturas() {
    fetch('/temperaturas')
    .then(response => {
        if (!response.ok) {
            throw new Error("Error HTTP");
        }
        return response.json();
    })
    .then(data => {
        actualizarSensor(data.sensor1, "temp1", "status1", "gauge1", "gaugeText1");
        actualizarSensor(data.sensor2, "temp2", "status2", "gauge2", "gaugeText2");
        actualizarSonido(data.sonido);
        actualizarVoltaje(data.voltaje);
    })
    .catch(error => {
        mostrarError("temp1", "status1", "gaugeText1", "gauge1");
        mostrarError("temp2", "status2", "gaugeText2", "gauge2");
        actualizarSonido(null);
        actualizarVoltaje(null);
    });
}

function actualizarSensor(temp, tempID, statusID, gaugeID, gaugeTextID) {
    if (temp === null || typeof temp !== "number" || !Number.isFinite(temp)) {
        mostrarError(tempID, statusID, gaugeTextID, gaugeID);
        return;
    }

    document.getElementById(tempID).innerText = temp.toFixed(1);
    document.getElementById(gaugeTextID).innerText = temp.toFixed(1) + "°";

    let porcentaje = temp / 100;
    if (porcentaje > 1) porcentaje = 1;
    if (porcentaje < 0) porcentaje = 0;
    let grados = porcentaje * 360;

    let color;
    if (temp < 50) {
        color = "#31e981";
    } else if (temp < 70) {
        color = "#f5c542";
    } else {
        color = "#ff5c5c";
    }

    document.getElementById(gaugeID).style.background =
        `conic-gradient(${color} 0deg, ${color} ${grados}deg, rgba(255,255,255,.07) ${grados}deg, rgba(255,255,255,.07) 360deg)`;

    let status = document.getElementById(statusID);
    let statusText = status.querySelector("span");

    if (temp < 50) {
        status.style.color = "#31e981";
        status.style.background = "rgba(49,233,129,.08)";
        statusText.innerText = "TEMPERATURA NORMAL";
    } else if (temp < 70) {
        status.style.color = "#f5c542";
        status.style.background = "rgba(245,197,66,.08)";
        statusText.innerText = "TEMPERATURA ALTA";
    } else {
        status.style.color = "#ff5c5c";
        status.style.background = "rgba(255,92,92,.08)";
        statusText.innerText = "TEMPERATURA CRÍTICA";
    }
}

function mostrarError(tempID, statusID, gaugeTextID, gaugeID) {
    document.getElementById(tempID).innerText = "--";
    document.getElementById(gaugeTextID).innerText = "--°";
    document.getElementById(gaugeID).style.background =
        `conic-gradient(#ff69b4 0deg, #ff69b4 15deg, rgba(255,255,255,.07) 15deg, rgba(255,255,255,.07) 360deg)`;

    let status = document.getElementById(statusID);
    let text = status.querySelector("span");

    status.style.color = "#ff69b4";
    status.style.background = "rgba(255,105,180,.08)";
    text.innerText = "ERROR DE SENSOR";
}

actualizarTemperaturas();
setInterval(actualizarTemperaturas, 2000);
</script>
</body>
</html>
